.gitignore
# ==========================================
# Cargo / Rust
# ==========================================
# Build artifacts directory generated by Cargo
/target/
/**/target/

Cargo.lock

# Cargo backup files generated by cargo publish
cargo-commits/


# ==========================================
# ROS 1 / Catkin
# ==========================================
# Catkin build outputs and environment generation
/build/
/devel/
/install/
/logs/
/**/build/
/**/devel/
/**/install/
/**/logs/

# Catkin workspace configuration files generated by catkin_init_workspace
.catkin_workspace
.built_by

# CMake generated files
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt


# ==========================================
# IDEs & Editor Configuration
# ==========================================
# Neovim / Vim / Emacs
*.swp
*.swo
*~
.netrwhist

# VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json

# CLion / RustRover / JetBrains
.idea/
*.iws
*.iml


# ==========================================
# System & Miscellaneous
# ==========================================
# OS generated files
.DS_Store
Thumbs.db

# Log files and crash dumps
*.log
core
